#!/usr/bin/env bash
# pm-stats - ParcelMoover numbers in the terminal (docs/MONITORING.md).
# Runs the read-only stats script inside the release slot serving traffic, so
# it always matches the deployed code. Install once on the EC2 host:
#   sudo ln -sf /var/www/express-app/deploy/pm-stats /usr/local/bin/pm-stats
set -Eeuo pipefail
APP_DIR=${APP_DIR:-/var/www/express-app}
container=$(bash "$APP_DIR/deploy/deploy-app.sh" active-container)
# Keep colours when a person is watching; plain text when piped (e.g. | jq).
if [[ -t 1 ]]; then tty=(-it); else tty=(-i); fi
# Small pool of its own: without this, each pm-stats run could open up to the
# app's 60 connections and crowd the live app out of Postgres. Its parallel
# queries queue for a slot, so allow a longer wait than the app's 5 s.
exec docker exec "${tty[@]}" -e DB_POOL_MAX=5 -e DB_POOL_CONNECTION_TIMEOUT_MS=30000 \
  "$container" node dist/scripts/stats.js "$@"
