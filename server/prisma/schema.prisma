model vendors {
  id                    String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id               String?           @unique @db.Uuid
  sales_user_id         String?           @db.Uuid
  rate_type             String            @default("flat") // per_destination | zone | flat
  // Per-vendor rate overrides; null falls back to the global pricing_settings.
  flat_inside_valley    Decimal?          @db.Decimal(12, 2)
  flat_outside_valley   Decimal?          @db.Decimal(12, 2)
  // Inside-valley destinations flagged outside the ring road (locations.ring_road
  // = "outside") are charged this rate instead of flat_inside_valley when set.
  flat_outside_ring_road Decimal?         @db.Decimal(12, 2)
  zone_major_cities     Decimal?          @db.Decimal(12, 2)
  zone_urban_areas      Decimal?          @db.Decimal(12, 2)
  zone_remote_areas     Decimal?          @db.Decimal(12, 2)
  zone_inside_valley    Decimal?          @db.Decimal(12, 2)
  // Optional cross-model override: a flat rate for inside-valley destinations
  // that takes precedence over rate_type when set. Null = no override.
  inside_valley_flat_rate Decimal?        @db.Decimal(12, 2)
  // Per-vendor branch-delivery rate overrides (null → global pricing_settings).
  branch_flat_inside_valley   Decimal?    @db.Decimal(12, 2)
  branch_flat_outside_valley  Decimal?    @db.Decimal(12, 2)
  branch_flat_outside_ring_road Decimal?  @db.Decimal(12, 2)
  branch_zone_major_cities    Decimal?    @db.Decimal(12, 2)
  branch_zone_urban_areas     Decimal?    @db.Decimal(12, 2)
  branch_zone_remote_areas    Decimal?    @db.Decimal(12, 2)
  branch_zone_inside_valley   Decimal?    @db.Decimal(12, 2)
  extra_weight_percent  Decimal?          @db.Decimal(5, 2)
  // Return-parcel charge as a percent of the normal delivery rate, split by the
  // destination's valley side. Null falls back to the global pricing_settings.
  return_inside_valley_percent  Decimal?  @db.Decimal(5, 2)
  return_outside_valley_percent Decimal?  @db.Decimal(5, 2)
  client_name           String
  business_name         String?
  phone                 String
  email                 String?
  location_id           String?           @db.Uuid
  address               String?
  sales                 String?
  pickup_landmark       String?
  billing_business_name String?
  registration_no       String?
  pan_vat_no            String?
  citizenship_doc       String?
  pan_vat_doc           String?
  business_cert_doc     String?
  bank_name             String?
  bank_account_no       String?
  bank_account_holder   String?
  status                user_status       @default(active)
  // Credit-control thresholds. Null falls back to the billing_settings
  // singleton, mirroring how the rate columns above fall back to
  // pricing_settings. Stored as the (negative) balance they trip at.
  billing_warn_threshold  Decimal?        @db.Decimal(12, 2)
  billing_block_threshold Decimal?        @db.Decimal(12, 2)
  // Vendor's own thermal sticker printer/label stock size, in millimeters.
  // Null falls back to the app default (100x75mm) - see
  // vendorPrintSettings.service.ts's resolveLabelSize. Self-service (the
  // vendor sets this themselves), unlike every other override above.
  label_width_mm        Int?
  label_height_mm       Int?
  // Which side of those thresholds this vendor was on at the last evaluation,
  // so a crossing notifies once instead of once per parcel delivered.
  billing_alert_state   vendor_billing_state @default(ok)
  billing_alert_at      DateTime?         @db.Timestamptz(6)
  joined_at             DateTime?         @db.Date
  last_ordered_at       DateTime?         @db.Timestamptz(6)
  // Set the moment the assigned sales rep uses their one allowed self-service
  // edit on this vendor; a non-null value blocks further sales-side edits.
  sales_edited_at       DateTime?         @db.Timestamptz(6)
  created_at            DateTime          @default(now()) @db.Timestamptz(6)
  updated_at            DateTime          @default(now()) @updatedAt @db.Timestamptz(6)
  deleted_at            DateTime?         @db.Timestamptz(6)
  // Lowercased business_name + client_name + phone + email, kept in sync by
  // trg_refresh_vendor_search_text. Backs the GIN trigram index below so the
  // vendor picker/filter search stays fast regardless of vendor count -
  // matches the parcels.search_text pattern.
  search_text           String?
  cod_collections       cod_collections[]
  parcels               parcels[]
  settlements           settlements[]
  locations             locations?        @relation(fields: [location_id], references: [id], onUpdate: NoAction)
  users                 users?            @relation("vendor_owner", fields: [user_id], references: [id], onUpdate: NoAction)
  sales_user            users?            @relation("vendor_sales_user", fields: [sales_user_id], references: [id], onUpdate: NoAction)
  api_keys              api_keys[]
  webhook_endpoints     webhook_endpoints[]
  vendor_payments       vendor_payments[]

  @@index([location_id], map: "idx_vendors_location_id")
  @@index([sales_user_id], map: "idx_vendors_sales_user_id")
  @@index([search_text(ops: raw("gin_trgm_ops"))], map: "idx_vendors_search_text", type: Gin)
}

// Vendor -> office payments, settling delivery charges the vendor owes. The
// opposite direction from `settlements`, which only models office -> vendor
// payouts and cannot carry a negative payable.
//
// A row starts as a claim ('pending'). It must never credit the vendor's
// balance before an admin verifies it, or a blocked vendor could unblock
// themselves by claiming a payment they never made.
model vendor_payments {
  id            String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  vendor_id     String                @db.Uuid
  amount        Decimal               @db.Decimal(12, 2)
  method        String                @default("fonepay")
  // Transaction id from the payment app, for reconciliation against the
  // merchant statement.
  reference     String?
  // Encrypted at rest like every other upload (see documentEncryption.ts).
  proof_path    String?
  status        vendor_payment_status @default(pending)
  note          String?
  submitted_by  String?               @db.Uuid
  reviewed_by   String?               @db.Uuid
  reviewed_at   DateTime?             @db.Timestamptz(6)
  review_remark String?
  created_at    DateTime              @default(now()) @db.Timestamptz(6)
  updated_at    DateTime              @default(now()) @updatedAt @db.Timestamptz(6)
  vendors       vendors               @relation(fields: [vendor_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users_vendor_payments_submitted_byTousers users? @relation("vendor_payments_submitted_byTousers", fields: [submitted_by], references: [id], onUpdate: NoAction)
  users_vendor_payments_reviewed_byTousers  users? @relation("vendor_payments_reviewed_byTousers", fields: [reviewed_by], references: [id], onUpdate: NoAction)

  @@index([vendor_id, status], map: "idx_vendor_payments_vendor_status")
  @@index([status, created_at(sort: Desc)], map: "idx_vendor_payments_status_created")
}

// Singleton configuration row, mirroring pricing_settings. Thresholds are the
// (negative) account balance they trip at: warn at -2000, block at -3000.
model billing_settings {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  warn_threshold  Decimal  @default(-2000) @db.Decimal(12, 2)
  block_threshold Decimal  @default(-3000) @db.Decimal(12, 2)
  // Static Fonepay QR shown to vendors in the pay-now flow.
  payment_qr_path String?
  payment_note    String?
  created_at      DateTime @default(now()) @db.Timestamptz(6)
  updated_at      DateTime @default(now()) @updatedAt @db.Timestamptz(6)
}

// Partner API keys — vendor-owned credentials for the public /api/v1 surface.
// Only the SHA-256 hash of the key is stored; the plaintext is shown once at creation.
model api_keys {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  vendor_id    String    @db.Uuid
  name         String
  key_prefix   String
  key_hash     String    @unique
  created_at   DateTime  @default(now()) @db.Timestamptz(6)
  last_used_at DateTime? @db.Timestamptz(6)
  revoked_at   DateTime? @db.Timestamptz(6)
  vendors      vendors   @relation(fields: [vendor_id], references: [id], onUpdate: NoAction)

  @@index([vendor_id], map: "idx_api_keys_vendor_id")
}

// Vendor-owned outbound webhook subscriptions for the public /api/v1 surface.
// secret_encrypted is reversible (AES-256-GCM) — unlike api_keys.key_hash, the
// server must reuse this secret to sign every future delivery, so it can't be
// a one-way hash. Only ever displayed to the vendor once, at creation.
model webhook_endpoints {
  id                   String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  vendor_id            String               @db.Uuid
  name                 String
  url                  String
  secret_encrypted     String
  event_types          String[]             @default([])
  enabled              Boolean              @default(true)
  consecutive_failures Int                  @default(0)
  disabled_at          DateTime?            @db.Timestamptz(6)
  created_at           DateTime             @default(now()) @db.Timestamptz(6)
  updated_at           DateTime             @default(now()) @updatedAt @db.Timestamptz(6)
  vendors              vendors              @relation(fields: [vendor_id], references: [id], onUpdate: NoAction)
  webhook_deliveries   webhook_deliveries[]

  @@index([vendor_id], map: "idx_webhook_endpoints_vendor_id")
}

// Outbox + delivery log for webhook_endpoints. A row is inserted in the same
// transaction as the order-status change it describes (transactional outbox),
// then drained/retried asynchronously by the sweep in index.ts.
model webhook_deliveries {
  id                   String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  webhook_endpoint_id  String            @db.Uuid
  event_type           String
  event_id             String            @db.Uuid
  payload              Json
  status               String            @default("pending")
  attempt_count        Int               @default(0)
  next_attempt_at      DateTime          @db.Timestamptz(6)
  last_attempted_at    DateTime?         @db.Timestamptz(6)
  last_status_code     Int?
  last_error           String?
  created_at           DateTime          @default(now()) @db.Timestamptz(6)
  webhook_endpoints    webhook_endpoints @relation(fields: [webhook_endpoint_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([status, next_attempt_at], map: "idx_webhook_deliveries_pending_sweep")
  @@index([webhook_endpoint_id, created_at(sort: Desc)], map: "idx_webhook_deliveries_endpoint_id")
}

// Single-row global pricing config for zone-based and flat (valley) rate types.
model pricing_settings {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  zone_major_cities    Decimal? @db.Decimal(12, 2)
  zone_urban_areas     Decimal? @db.Decimal(12, 2)
  zone_remote_areas    Decimal? @db.Decimal(12, 2)
  zone_inside_valley   Decimal? @db.Decimal(12, 2)
  flat_inside_valley   Decimal? @db.Decimal(12, 2)
  flat_outside_valley  Decimal? @db.Decimal(12, 2)
  // Inside-valley destinations flagged outside the ring road (locations.ring_road
  // = "outside") are charged this rate instead of flat_inside_valley when set.
  flat_outside_ring_road Decimal? @db.Decimal(12, 2)
  // Parallel branch-delivery rate set (used when service_type = branch_delivery).
  branch_zone_major_cities    Decimal? @db.Decimal(12, 2)
  branch_zone_urban_areas     Decimal? @db.Decimal(12, 2)
  branch_zone_remote_areas    Decimal? @db.Decimal(12, 2)
  branch_zone_inside_valley   Decimal? @db.Decimal(12, 2)
  branch_flat_inside_valley   Decimal? @db.Decimal(12, 2)
  branch_flat_outside_valley  Decimal? @db.Decimal(12, 2)
  branch_flat_outside_ring_road Decimal? @db.Decimal(12, 2)
  extra_weight_percent Decimal? @db.Decimal(5, 2)
  free_weight_kg       Decimal  @default(2) @db.Decimal(10, 3)
  // Global default return-parcel charge as a percent of the normal delivery
  // rate, split by the destination's valley side (e.g. 0% inside, 50% outside).
  return_inside_valley_percent  Decimal? @db.Decimal(5, 2)
  return_outside_valley_percent Decimal? @db.Decimal(5, 2)
  created_at           DateTime @default(now()) @db.Timestamptz(6)
  updated_at           DateTime @default(now()) @updatedAt @db.Timestamptz(6)
}

// Per-status SLA thresholds (hours). One row per configurable key: each pickup/
// delivery/transit parcel status plus the singleton 'remarks' and 'return' keys.
// sla_hours NULL = SLA disabled for that key.
model sla_settings {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  status_key String   @unique
  sla_hours  Int?
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)
}

// Pickup windows vendors can choose from when raising a "pickup" support
// ticket. start_minutes/end_minutes are minutes-since-midnight; the booking
// cutoff (1hr before end) is derived, not stored.
model pickup_time_slots {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  start_minutes Int
  end_minutes   Int
  is_active     Boolean  @default(true)
  sort_order    Int      @default(0)
  created_at    DateTime @default(now()) @db.Timestamptz(6)
  updated_at    DateTime @default(now()) @updatedAt @db.Timestamptz(6)
}

// Configurable settlement payment methods (Cash, Online, eSewa, Bank, ...).
// Managed by super admins; consumed by the settlement "Make Payment" flow.
// Soft-disabled via is_active so historical settlements keep referencing the
// name even after a method is retired.
model payment_methods {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String   @unique
  is_active  Boolean  @default(true)
  sort_order Int      @default(0)
  /// The ledger account this method's money lands in. Created with the method,
  /// so adding "Prabhu Bank" gives it a balance of its own rather than merging
  /// into a shared bucket. Null only for rows created before this existed.
  ledger_account_id String?          @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  ledger_account    ledger_accounts? @relation(fields: [ledger_account_id], references: [id], onUpdate: NoAction)
}

