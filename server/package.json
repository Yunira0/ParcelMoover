{
  "name": "server",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "prisma generate && tsc",
    "start": "prisma migrate deploy && node dist/index.js",
    "redis": "redis-server --save \"\" --appendonly no",
    "prisma:generate:soft": "prisma generate || echo \"WARN: prisma generate failed (engine locked?) - generated client may be stale\"",
    "server:dev": "npm run prisma:generate:soft && nodemon -L ./src/index.ts",
    "dev": "concurrently -n redis,server -c magenta,cyan npm:redis npm:server:dev",
    "docs:build": "ts-node --transpile-only scripts/build-partner-docs.ts",
    "seed:roles": "ts-node --transpile-only prisma/seed-roles.ts",
    "seed:vendors-staff": "ts-node --transpile-only prisma/seed-vendors-staff.ts",
    "seed:accounting": "ts-node --transpile-only prisma/seed-accounting.ts",
    "backfill:ledger": "ts-node --transpile-only src/scripts/backfill-ledger.ts",
    "reconcile:ledger": "ts-node --transpile-only src/scripts/reconcile-ledger.ts",
    "resync:postings": "ts-node --transpile-only src/scripts/resync-postings.ts",
    "resync:postings:prod": "node dist/scripts/resync-postings.js",
    "backfill:ledger:prod": "node dist/scripts/backfill-ledger.js",
    "reconcile:ledger:prod": "node dist/scripts/reconcile-ledger.js",
    "check:vendorless": "ts-node --transpile-only scripts/check-vendorless-postings.ts",
    "fix:vendorless-parcels": "ts-node --transpile-only scripts/attribute-vendorless-parcels.ts",
    "fix:unrouted-settlements": "ts-node --transpile-only scripts/repoint-unrouted-settlements.ts",
    "migrate:encrypt-uploads": "ts-node --transpile-only scripts/encrypt-existing-uploads.ts",
    "backfill:picked-up-at": "ts-node --transpile-only scripts/backfill-picked-up-at.ts",
    "reconcile:settlement-status": "ts-node --transpile-only scripts/reconcile-settlement-payment-status.ts",
    "reconcile:undelivered-cod": "ts-node --transpile-only scripts/reconcile-undelivered-cod.ts",
    "debrand:carrier-remarks": "ts-node --transpile-only scripts/debrand-carrier-remarks.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "prisma": {
    "seed": "ts-node --transpile-only prisma/seed-roles.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^6.19.3",
    "@prisma/client": "6.19.3",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "file-type": "^22.0.1",
    "helmet": "^8.2.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "nepali-date-converter": "^3.4.0",
    "nodemailer": "^9.0.1",
    "pg": "^8.21.0",
    "rate-limit-redis": "^5.0.0",
    "sharp": "^0.35.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0",
    "@types/nodemailer": "^8.0.1",
    "@types/node": "^25.9.1",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.0",
    "concurrently": "^10.0.3",
    "nodemon": "^3.1.14",
    "prisma": "6.19.3",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
